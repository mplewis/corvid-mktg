---
import { Home } from "../components/Home";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content="Corvid Design" />
    <meta
      property="og:description"
      content="Thoughtful products for photographers and travelers"
    />
    <meta property="og:image" content="https://corvid.design/open-graph.png" />
    <meta
      property="og:image:alt"
      content="Corvid Design logo on a white background"
    />

    <title>Corvid Design</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=SN+Pro:wght@400;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Home />
  </body>
</html>

<style>
  * {
    font-family: "SN Pro", sans-serif;
  }
</style>
